# Environment-variable template. Do not commit real secrets.
# The local .env file is loaded for development. Process environment variables take precedence.
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Karachi

MYSQL_DATABASE=exam_platform
MYSQL_USER=exam_user
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Private, non-web-served directory for advisory proctoring evidence.
PROCTOR_EVIDENCE_ROOT=private_proctor_evidence
PROCTOR_EVIDENCE_RETENTION_DAYS=30
