# Environment-variable template. Do not commit real secrets.
# Django does not load .env files by itself in this project. Export these values in
# PowerShell, configure your IDE run profile, or use a process manager that loads .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Karachi

MYSQL_DATABASE=exam_platform
MYSQL_USER=exam_user
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
